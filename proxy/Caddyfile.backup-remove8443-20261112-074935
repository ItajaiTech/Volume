{
	# Redirects are explicit so the legacy .local names can point to .test.
	auto_https disable_redirects
}

# Ponto: .test is canonical; .local remains only as a compatibility redirect.
http://ponto.local {
	redir https://ponto.test{uri} 308
}

https://ponto.local {
	tls internal
	redir https://ponto.test{uri} 308
}

http://ponto.test {
	redir https://ponto.test{uri} 308
}

https://ponto.test {
	tls internal
	reverse_proxy https://127.0.0.1:5000 {
		transport http {
			tls_insecure_skip_verify
		}
		header_up X-Forwarded-Proto https
	}
}

# Administrative Ponto hostname is unchanged.
http://ponto.admin {
	redir https://ponto.admin{uri} 301
}

https://ponto.admin {
	tls internal
	reverse_proxy https://127.0.0.1:5000 {
		transport http {
			tls_insecure_skip_verify
		}
		header_up X-Forwarded-Proto https
	}
}

# Volume: .test is canonical; .local remains only as a compatibility redirect.
http://volume.local {
	redir https://volume.test{uri} 308
}

https://volume.local {
	tls internal
	redir https://volume.test{uri} 308
